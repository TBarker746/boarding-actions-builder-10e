              <profiles>
                <profile name="Astral Predation" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="6493-e804-8c4e-e3b3">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per battle, in your Movement phase, when the bearer is selected to move, it can use this Enhancement. If it does, select one closed Hatchway on the battlefield. Until the end of the phase, the bearer can move through that Hatchway as if it was open (note that this does not open that Hatchway - it remains closed).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
