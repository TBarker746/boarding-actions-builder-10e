          </modifiers>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Warp Mastery" hidden="false" id="5f78-357b-9b54-d906" collective="false">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="46fd-56a8-6e6c-8b9a" percentValue="false" includeChildSelections="true" includeChildForces="true"/>
