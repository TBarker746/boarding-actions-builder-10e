  <sharedProfiles>
    <profile id="cb08-29a7-4ffc-2561" name="Damaged: 1-5 wounds remaining" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model has 1-5 wounds remaining, each time this model makes an attack, subtract 1 from the Hit roll.</characteristic>
      </characteristics>
    </profile>
    <profile name="Empyric Guidance (Psychic)" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="660e-ccb9-65e7-19f">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a friendly unit is affected by a Battlefield Command Stratagem used by this model, weapons equipped by models in that unit have the **[LETHAL HITS]** ability.</characteristic>
      </characteristics>
    </profile>
