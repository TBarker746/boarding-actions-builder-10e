                            <condition type="equalTo" value="1" field="selections" scope="parent" childId="064a-0470-60eb-e3ef" shared="true" includeChildSelections="true"/>
                            <condition type="equalTo" value="1" field="selections" scope="parent" childId="eeda-8544-a2f3-3fab" shared="true" includeChildSelections="true"/>
