              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="roster" childId="0dcd-1748-b35e-55cb" shared="true" includeChildSelections="true" includeChildForces="true" childName="Devoted Thralls"/>
              </conditions>
            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Prescient Authority" hidden="false" id="c8f3-7a6f-5523-ad37" collective="false">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="cb7d-2b5a-e2c8-2b70" percentValue="false" includeChildSelections="true" includeChildForces="true"/>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="f17e-9f18-2a16-f156" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
              </constraints>
              <profiles>
                <profile name="Prescient Authority" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="db2e-f16f-d7cb-c478">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per turn, when a friendly **^^TZAANGORS^^** unit within 3&quot; of the bearer is selected to shoot or fight, the bearer can use this Enhancement. If it does, until the end of the phase, each time a model in that **^^TZAANGORS^^** unit makes an attack, re-roll a Wound roll of 1.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Thrallmaster" hidden="false" id="321b-b730-edb6-d58a" collective="false">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="fd09-19ef-bd0f-a9e3" percentValue="false" includeChildSelections="true" includeChildForces="true"/>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="2462-4774-a752-060d" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
              </constraints>
              <profiles>
                <profile name="Thrallmaster" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="63be-d3e4-8d01-3479">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the first battle round, you can select one friendly **^^TZAANGORS^^** unit within the same Entry Zone as the bearer. If you do, that unit can make a Normal move of up to 6&quot;.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Chosen Cabal Enhancements" id="d35a-b5ee-9781-c387" hidden="false" collective="false" import="true">
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="roster" childId="fccc-c48d-0be3-d587" shared="true" includeChildSelections="true" includeChildForces="true" childName="Chosen Cabal"/>
