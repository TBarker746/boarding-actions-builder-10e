        <profile id="fbf7-d855-510e-709d" name="Prince of Slaanesh" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a friendly unit is affected by a Battlefield Command Stratagem used by this model, each time a model in that unit makes a melee attack, a successful unmodified Wound roll of 5+ scores a Critical Wound.</characteristic>
          </characteristics>
        </profile>
        <profile id="3d1c-cff8-7ed8-16f1" name="Delightful Agonies" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The first time this model is destroyed, roll one D6 at the end of the phase. On a 2+, set this model back up on the battlefield, as close as possible to where it was destroyed and not within Engagement Range of any enemy units, with its full wounds remaining.</characteristic>
          </characteristics>
        </profile>
        <profile id="4cf4-26b3-20a5-a5b4" name="Leader" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
