              </constraints>
              <profiles>
                <profile name="Fatal Caress" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="5ff3-abf4-8fec-3696">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time the bearer makes a melee attack, a Critical Wound is scored on an unmodified Wound roll of 5+.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
