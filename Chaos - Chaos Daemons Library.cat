        <profile id="9f4b-f27f-a2e5-4450" name="Prince of Darkness (Aura)" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a friendly **^^LEGIONES DAEMONICA^^** unit is within 6&quot; of this model, models in that unit have the Stealth ability.</characteristic>
          </characteristics>
        </profile>
        <profile id="6896-fcc7-13ac-117a" name="Unholy Vigour" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per battle, at the start of any phase, this model can use this ability. If it does, until the end of the phase, this model has a 3+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
        <profile id="80d1-1d2-69a-2359" name="Invulnerable Save" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
