        <profile id="8b1b-ebfa-1032-f615" name="The Eternal Dance" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the Fight phase, select one enemy unit within 6&quot; of this model. Until the end of the phase:
■ Each time a friendly **^^SLAANESH LEGIONES DAEMONICA^^** model makes a melee attack that targets that enemy unit, add 1 to the Wound roll.
■ Each time a model in that enemy unit makes a melee attack, subtract 1 from the Wound roll.</characteristic>
          </characteristics>
        </profile>
        <profile id="b12d-9aee-1920-6565" name="Dazzling Acrobatics" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
