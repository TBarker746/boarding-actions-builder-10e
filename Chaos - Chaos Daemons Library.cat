          </characteristics>
        </profile>
        <profile name="Daemonic Lord" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="3bb7-1f96-d6c5-4646">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is within 3&quot; of one or more friendly ^^**Legiones Daemonica^^** Infantry units, this model has the Lone Operative ability.</characteristic>
          </characteristics>
        </profile>
      </profiles>
