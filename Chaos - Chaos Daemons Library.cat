              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9f74-1e35-6d64-c563" percentValue="false" includeChildSelections="true" includeChildForces="true"/>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="7b76-2388-e68e-7e47" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
              </constraints>
