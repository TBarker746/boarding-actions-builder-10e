          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model can use the Battlefield Command Stratagem on the following unit:

■ ^^**FLAMERS^^**</characteristic>
          </characteristics>
        </profile>
        <profile id="c233-f3e4-de21-f67e" name="Exalted Flamer" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">9&quot;</characteristic>
