            <selectionEntry type="upgrade" import="true" name="Horrifying Visage" hidden="false" id="290d-53d4-f787-1dc5" collective="false">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b476-d743-f28d-f666" percentValue="false" includeChildSelections="true" includeChildForces="true"/>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="154d-8313-6815-63d5" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
