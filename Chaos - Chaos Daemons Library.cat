        <profile id="1c90-5f23-d62b-f9f0" name="Malefic Destruction" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per battle, at the start of the Fight phase, this model can use this ability. If it does, until the end of the phase, add 3 to the Attacks characteristic of this model’s hellforged weapons.</characteristic>
          </characteristics>
        </profile>
        <profile id="2c04-568d-8702-a2dd" name="Harbinger of Death" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time this model is selected to fight, select one of the following abilities. Until the end of the phase, this model’s hellforged weapons have that ability:
■ **[LETHAL HITS]**
■ **[PRECISION]**
■ **[SUSTAINED HITS 1]**</characteristic>
          </characteristics>
        </profile>
        <profile id="c1ef-c0b2-3ca2-43d1" name="Invulnerable Save" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model has a 4+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
