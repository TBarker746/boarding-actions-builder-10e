      <selectionEntryGroups>
        <selectionEntryGroup id="efea-fc11-4905-f5b9" name="Detachment" hidden="false" collective="false" import="true" defaultSelectionEntryId="none">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2146-a293-fdcf-f271" type="min"/>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="11f1-879f-788f-19eb" type="max"/>
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Void Salvagers" hidden="false" id="437f-0cb8-194f-a716">
              <rules>
                <rule name="Stalwart Advance" id="d1ac-e240-653c-cc9c" hidden="false">
                  <description>In your Shooting phase, each time a **^^LEAGUES OF VOTANN^^** unit from your army has shot, if one or more enemy units were destroyed by those attacks and that **^^LEAGUES OF VOTANN^^** unit is not within Engagement Range of one or more enemy units, it can make a Normal move of up to 3&quot; and can then attempt to operate a Hatchway.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Hearthfire Strike" hidden="false" id="2d0a-a561-1ef8-75cd">
              <rules>
                <rule name="Wrought in Wrath" id="67fc-8ce3-ca50-4058" hidden="false">
                  <description>Add 1 to Advance and Charge rolls made for **^^LEAGUES OF VOTANN^^** units from your army.</description>
                </rule>
                <rule name="Rules Adaptations" id="d387-5811-ee98-4ed7" hidden="false">
                  <description>■ **^^EINHYR HEARTHGUARD^^** units can perform the Secure Site Tactical Manoeuvre as if they had the **^^BATTLELINE^^** keyword.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <costs>
        <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
      </costs>
    </selectionEntry>
