    <selectionEntry id="8f33-5601-3707-78f4" name="Brôkhyr Iron-master" hidden="false" collective="false" import="true" type="unit">
      <constraints>
        <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="aa75-c505-8fff-0e59" type="max"/>
