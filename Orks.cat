          <characteristics>
            <characteristic name="Capacity" typeId="30f2-be70-861d-1b84">This model has a transport capacity of 22 **^^ORKS INFANTRY^^** models. Each **^^MEGA ARMOUR^^** or **^^JUMP PACK^^** model takes up the space of 2 models.</characteristic>
          </characteristics>
        </profile>
