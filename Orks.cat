    <selectionEntryGroup name="Enhancement Weapon Upgrades" id="842b-9f68-c894-4808" hidden="false">
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Trademark Weapon Upgrade" hidden="false" id="5409-bf6a-87d5-258c">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0ada-38b1-c994-5532"/>
            <constraint type="min" value="0" field="selections" scope="model" shared="true" id="627c-7282-0530-8e31" includeChildSelections="true"/>
          </constraints>
          <modifierGroups>
            <modifierGroup type="and">
              <modifiers>
                <modifier type="append" value="Trademark Weapon" field="annotation" join=", " scope="upgrade" affects="self.entries.profiles.Ranged Weapons"/>
                <modifier type="increment" value="1" field="2229-f494-25db-c5d3" scope="upgrade" affects="self.entries.profiles.Ranged Weapons"/>
                <modifier type="increment" value="1" field="a354-c1c8-a745-f9e3" scope="upgrade" affects="self.entries.profiles.Ranged Weapons"/>
              </modifiers>
            </modifierGroup>
          </modifierGroups>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition type="lessThan" value="1" field="selections" scope="model" childId="fc58-ea56-b7c6-f3c4" shared="true" includeChildSelections="true" childName="Trademark Weapon"/>
                    <condition type="notInstanceOf" value="1" field="selections" scope="upgrade" childId="eeda-8544-a2f3-3fab" shared="true" includeChildSelections="true"/>
                    <condition type="instanceOf" value="1" field="selections" scope="upgrade" childId="064a-0470-60eb-e3ef" shared="true" includeChildSelections="true"/>
                  </conditions>
                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition type="atLeast" value="1" field="selections" scope="model-or-unit" childId="5409-bf6a-87d5-258c" shared="true" includeChildSelections="true"/>
                        <condition type="lessThan" value="1" field="selections" scope="parent" childId="5409-bf6a-87d5-258c" shared="true" includeChildSelections="true"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </conditionGroup>
              </conditionGroups>
            </modifier>
            <modifier type="set" value="1" field="627c-7282-0530-8e31">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="model" childId="fc58-ea56-b7c6-f3c4" shared="true" includeChildSelections="true" childName="Trademark Weapon"/>
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
