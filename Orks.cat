        <profile name="Ramshackle Cover" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="d8d6-4ad6-398a-e67d">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time a ranged attack is allocated to a model, if that model is not fully visible to every model in the attacking unit because of this **^^VEHICLE^^**, that model has the Benefit of Cover against that attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="Shoutin’ Pole (Aura)" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="69a-6435-91dc-1">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a friendly **^^ORKS^^** unit is within 6&quot; of this **^^VEHICLE^^**, improve the Leadership characteristic of models in that unit by 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="Big&apos;ed Bossbunka" typeId="74f8-5443-9d6d-1f1e" typeName="Transport" hidden="false" id="3a93-176b-7f67-8845">
          <characteristics>
            <characteristic name="Capacity" typeId="30f2-be70-861d-1b84">This model has a transport capacity of 11 **^^ORKS INFANTRY^^** models. Each **^^MEGA ARMOUR^^** or **^^JUMP PACK^^** model takes up the space of 2 models.</characteristic>
          </characteristics>
        </profile>
      </profiles>
