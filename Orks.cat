          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of your Movement phase, roll one D6 for each objective marker you control that has one or more units from your army with this ability within range of it (excluding Battle-shocked units). If one or more of those rolls is a 4+, you gain 1CP.</characteristic>
          </characteristics>
        </profile>
