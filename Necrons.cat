            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">8</characteristic>
          </characteristics>
        </profile>
        <profile name="Eternity Gate" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="35bb-28ec-497-5cff">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">In the Reinforcements step of your Movement phase, you can select one **^^NECRONS INFANTRY^^** unit from your army that is either in Reserves or on the battlefield (if you select the latter, remove that unit from the battlefield and place it into Reserves). That unit is then set up anywhere on the battlefield that is wholly within 6&quot; of this model and not within Engagement Range of any enemy models. That unit cannot declare a charge this turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
