            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="roster" childId="5f1b-2ad8-0439-b303" shared="true" includeChildSelections="true" includeChildForces="true" childName="Canoptek Harvesters"/>
              </conditions>
            </modifier>
          </modifiers>
          <selectionEntries>
