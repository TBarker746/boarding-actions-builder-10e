                <characteristic name="W" typeId="750a-a2ec-90d3-21fe">16</characteristic>
                <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
                <characteristic name="OC" typeId="bef7-942a-1a23-59f8">6</characteristic>
              </characteristics>
