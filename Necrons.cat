          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is within range of an objective marker you control, enemy units that are set up on the battlefield from Reserves cannot be set up within 12&quot; of this model.</characteristic>
          </characteristics>
        </profile>
