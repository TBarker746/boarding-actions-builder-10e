        <profile name="Invulnerable Save" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="a0a0-e859-3d2e-1921">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model has a 5+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
        <profile name="Phase Shift Generator (Aura)" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="c6d3-ff20-7a9f-7fa9">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a friendly **^^NECRONS^^** unit is within 3&quot; of this **^^VEHICLE^^**, models in that unit have a 5+ invulnerable save against ranged attacks.</characteristic>
          </characteristics>
        </profile>
        <profile name="Phase-shifted Cover" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="d441-6f10-fc92-80f3">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time a ranged attack is allocated to a model, if that model is not fully visible to every model in the attacking unit because of this **^^VEHICLE^^**, that model has the Benefit of Cover against that attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged: 1-7 wounds remaining" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="a375-dc94-e838-aa">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model has 1-7 wounds remaining, each time this model makes an attack, subtract 1 from the Hit roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
