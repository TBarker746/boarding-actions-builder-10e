  <sharedSelectionEntries>
    <selectionEntry type="upgrade" import="true" name="Detachment" hidden="false" id="82f1-b597-7b06-8ba2">
      <constraints>
        <constraint type="min" value="1" field="selections" scope="roster" shared="true" id="7fb2-a692-a5e8-2741" includeChildSelections="true" includeChildForces="true"/>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="1985-ef7c-a9f0-12c9" includeChildSelections="true" includeChildForces="true"/>
      </constraints>
      <selectionEntryGroups>
        <selectionEntryGroup name="Detachment" hidden="false" id="aa9c-b6d6-f78-12ac" defaultSelectionEntryId="none">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="5807-8909-f15b-dd04"/>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="57c7-9dcf-afa-964e"/>
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Tomb Ship Complement" hidden="false" id="6aa4-b9c2-a5e6-385e">
              <rules>
                <rule name="Conquest Protocols" id="36be-e412-1ab2-5012" hidden="false">
                  <description>Each time a **^^NECRONS^^** model from your army makes an attack, if that model is within range of an objective marker or the target of that attack is within range of an objective marker, on a Critical Wound, improve the Armour Penetration characteristic of that attack by 1.</description>
                </rule>
                <rule name="Rules Adaptations" id="4d3e-d2a3-cb4c-3647" hidden="false">
                  <description>■ When setting up **^^ILLUMINOR SZERAS^^** or a **^^SKORPEKH LORD^^** on the battlefield, no other units can be set up within the same Entry Zone they are set up in.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Harbinger Cabal" hidden="false" id="9d21-e807-1b94-e499">
              <rules>
                <rule name="Arcanoscientific Expertise" id="d022-fa0a-998f-72b1" hidden="false">
                  <description>In your Command phase, for each **^^CRYPTEK**^^ unit in your army, select one of the following abilities. Until the start of your next Command phase, your unit has that ability.
■ Hyperlocation Stutter (Aura): While a friendly **^^NECRONS**^^ unit is within 6&quot; of this model, add 2 to Advance rolls made for that unit.
■ Transharmonic Disruption (Aura): While a friendly **^^NECRONS**^^ unit is within 6&quot; of this model, add 1 to the Strength characteristic of weapons equipped by models in that unit.
■ Quantum Interface (Aura): While a friendly **^^NECRONS**^^ unit is within 6&quot; of this model, models in that unit have a 5+ invulnerable save.
</description>
                </rule>
                <rule name="Rules Adaptations" id="ae57-0fff-80c2-a325" hidden="false">
                  <description>■ When setting up **^^ILLUMINOR SZERAS^^** on the battlefield, no other units can be set up within the same Entry Zone they are set up in.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Deranged Outcasts" hidden="false" id="199c-04eb-d53e-58b9">
              <rules>
                <rule name="Terrifying Charge" id="5279-e274-33a2-cd4d" hidden="false">
                  <description>Each time a **^^NECRONS^^** unit from your army declares a charge, each enemy unit that is a target of that charge must take a Leadership test: if failed, until the end of the turn, each time a model in that enemy unit makes an attack, subtract 1 from the Hit roll.</description>
                </rule>
                <rule name="Rules Adaptations" id="5cf4-9556-614d-2cc8" hidden="false">
                  <description>■ When setting up a **^^SKORPEKH LORD^^** on the battlefield, no other units can be set up within the same Entry Zone they are set up in.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Canoptek Harvesters" hidden="false" id="5f1b-2ad8-0439-b303">
              <rules>
                <rule name="Retribution Protocols" id="8eb0-c42b-346b-a9ca" hidden="false">
                  <description>Each time an enemy unit destroys a **^^CRYPTEK^^** model from your army, until the end of the battle, each time a **^^NECRONS^^** model from your army makes an attack that targets that enemy unit, you can re-roll the Hit roll.</description>
                </rule>
                <rule name="Rules Adaptations" id="e0f0-5d81-0d55-4ef6" hidden="false">
                  <description>■ **^^CRYPTEK^^** units can perform the Secure Site Tactical Manoeuvre as if they had the **^^BATTLELINE^^** keyword.
■ When setting up **^^ILLUMINOR SZERAS^^** on the battlefield, no other units can be set up within the same Entry Zone they are set up in.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <categoryLinks>
        <categoryLink targetId="4ac9-fd30-1e3d-b249" id="cbf9-d740-dd4d-e9d5" primary="true" name="Configuration"/>
      </categoryLinks>
    </selectionEntry>
