        <selectionEntryGroup name="Breaching Operations Enhancements" id="4d08-b1cb-4917-0b3a" hidden="false" collective="false" import="true">
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="roster" childId="9e6e-58e6-2f65-7095" shared="true" includeChildSelections="true" includeChildForces="true" childName="Breaching Operations Enhancements"/>
              </conditions>
            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Breaching Charges" hidden="false" id="af5b-7f33-0a0e-faf5" collective="false">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e0ca-46c5-6b0d-6eea" percentValue="false" includeChildSelections="true" includeChildForces="true"/>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="3f3f-d0f4-f5e9-1410" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
              </constraints>
              <profiles>
                <profile name="Breaching Charges" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="efe0-8429-d63f-2e9b">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">In your Movement phase, when the bearer is selected to move, at the start or the end of that move if the bearer is within 1&quot; of a Weakened Wall that has not been breached, it can use this Enhancement. If it does so, that Weakened Wall&apos;s Vulnerable Section is destroyed. In addition, each unit that is on the opposite side of that Weakened Wall and is visible to and within 6&quot; of it suffers 1 mortal wound.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Spoor Seeker" hidden="false" id="76ff-aa55-76f8-d7c1" collective="false">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c1b4-aafc-8f4c-dd73" percentValue="false" includeChildSelections="true" includeChildForces="true"/>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="ed44-c441-2088-86de" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
              </constraints>
              <profiles>
                <profile name="Spoor Seeker" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="3bd6-cdf9-cae5-245e">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">In your Movement phase, when the bearer is selected to move, at the start or the end of that move if the bearer is within 1&quot; of a Weakened Wall that has not been breached, it can use this Enhancement. If it does so, select one enemy unit that is on the opposite side of and visible to that Weakened Wall. Until the end of the turn, each time a friendly model makes an attack against that enemy unit, add 1 to the HIt roll and add 1 to the Wound roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Paralysing Assault" hidden="false" id="a5b7-8c19-67d7-8603" collective="false">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e311-4f8a-af6d-e91c" percentValue="false" includeChildSelections="true" includeChildForces="true"/>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="76b1-f7f0-10c8-5101" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
              </constraints>
              <profiles>
                <profile name="Paralysing Assault" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="fa4b-7d05-7aee-bad9">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">In your Movement phase, when the bearer is selected to move, at the start or the end of that move if the bearer is within 1&quot; of a Weakened Wall that has not been breached, it can use this Enhancement. If it does, each enemy unit that is on the opposite side of and visible to that Weakened Wall is stunned. Each time a unit is stunned, until the end of the turn, that unit cannot fire Overwatch and each time a model in that unit makes an attack, subtract 1 from the Hit roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Tomb Ship Complement Enhancements" id="8ac0-39bf-930b-412c" hidden="false" collective="false" import="true">
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="roster" childId="6aa4-b9c2-a5e6-385e" shared="true" includeChildSelections="true" includeChildForces="true" childName="Tomb Ship Complement"/>
              </conditions>
            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Resurrection Protocols" hidden="false" id="7dd3-0fb8-26d9-1fec" collective="false">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="387b-f45b-a54a-ad4b" percentValue="false" includeChildSelections="true" includeChildForces="true"/>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="aadc-08c4-061d-9f3d" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
              </constraints>
              <profiles>
                <profile name="Resurrection Protocols" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="712f-fc9b-88bc-935c">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The first time the bearer is destroyed, roll one D6 at the end of the phase. On a 2+, set the bearer back up on the battlefield, as close as possible to where it was destroyed and not within Engagement Range of any enemy units, with D3 wounds remaining.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Mindshackle Scarabs" hidden="false" id="8df1-080d-a9be-1af5" collective="false">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a77a-df81-d73c-b980" percentValue="false" includeChildSelections="true" includeChildForces="true"/>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="ba79-1fcc-c0d2-93ee" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
              </constraints>
              <profiles>
                <profile name="Mindshackle Scarabs" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="63b1-6859-2104-4058">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**^^CRYPTEK^^** model only. In your Command phase, select one enemy unit within 12&quot; of and visible to the bearer. That enemy unit must take a Leadership test, subtracting 1 from the result: if failed, until the start of your next Command phase, subtract 2&quot; from the Move characteristic of models in that enemy unit and subtract 2 from Advance and Charge rolls made for it.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
              </costs>
              <modifiers>
                <modifier type="set" value="true" field="hidden">
                  <conditions>
                    <condition type="notInstanceOf" value="1" field="selections" scope="model-or-unit" childId="a98a-4cc0-5f02-e078" shared="true" childName="Cryptek"/>
                  </conditions>
                </modifier>
              </modifiers>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Harbinger Cabal Enhancements" id="1930-fa9d-37e4-c6b2" hidden="false" collective="false" import="true">
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="roster" childId="9d21-e807-1b94-e499" shared="true" includeChildSelections="true" includeChildForces="true" childName="Harbinger Cabal"/>
              </conditions>
            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Cryptometric Experimentation" hidden="false" id="006f-2588-719a-ec2a" collective="false">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5ec7-5350-55d3-ae48" percentValue="false" includeChildSelections="true" includeChildForces="true"/>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="955d-2805-17b9-e339" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
              </constraints>
              <profiles>
                <profile name="Cryptometric Experimentation" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="6926-c928-5aed-aefd">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Add 1 to the Toughness and Wounds characteristics of the bearer. The bearer has a 4+ invulnerable save.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Invulnerable Save" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="c917-b646-60d8-c4f8">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model has a 4+ invulnerable save.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
              </costs>
              <modifiers>
                <modifier type="increment" value="1" field="d29d-cf75-fc2d-34a4" scope="model" affects="profiles.Unit"/>
                <modifier type="increment" value="1" field="750a-a2ec-90d3-21fe" scope="model" affects="profiles.Unit"/>
              </modifiers>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Portal Transmuter" hidden="false" id="58af-a7e9-80ce-f499" collective="false">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b908-188a-40ca-e0e0" percentValue="false" includeChildSelections="true" includeChildForces="true"/>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="e8c7-3a4a-8cff-a886" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
              </constraints>
              <profiles>
                <profile name="Portal Transmuter" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="b416-6623-784f-9b97">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per turn, when the bearer ends a Normal, Advance or Fall Back move within 3&quot; of an open Hatchway or when the bearer opens a Hatchway, it can, before any units decide if they wish to fire Overwatch, use this ability. If it does, remove the bearer from the battlefield and set it back up on the battlefield wholly within 3&quot; of another open Hatchway and not within Engagement Range of one or more enemy units. When doing so, if the bearer cannot be set back up on the battlefield, it is destroyed.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Deranged Outcasts Enhancements" id="2315-25a1-71a7-264c" hidden="false" collective="false" import="true">
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="roster" childId="199c-04eb-d53e-58b9" shared="true" includeChildSelections="true" includeChildForces="true" childName="Deranged Outcasts"/>
              </conditions>
            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Inured to Damage" hidden="false" id="82a7-cbdb-ebd2-32ba" collective="false">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b63a-c48d-5e41-2bb6" percentValue="false" includeChildSelections="true" includeChildForces="true"/>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="24e7-b66a-3709-23ca" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
              </constraints>
              <profiles>
                <profile name="Inured to Damage" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="0c4b-f566-2f77-7688">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The bearer has the Feel No Pain 6+ ability. Once the bearer has destroyed one or more enemy units, it has the Feel No Pain 5+ ability instead.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Feel No Pain" id="3542-e2dc-1e08-6775" hidden="false" type="rule" targetId="9bf4-280f-bbe2-6fbb">
                  <modifiers>
                    <modifier type="append" value="6+" field="name"/>
                  </modifiers>
                </infoLink>
              </infoLinks>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Domineering Presense" hidden="false" id="8411-fb8d-478e-fada" collective="false">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3d55-2566-901b-2563" percentValue="false" includeChildSelections="true" includeChildForces="true"/>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="f672-3c23-f549-33fb" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
              </constraints>
              <profiles>
                <profile name="Domineering Presence" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="b52c-a5d5-4d52-404d">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">In your opponent’s Command phase, at the start of the Battle-shock step, select one enemy unit within 3&quot; of the bearer; that enemy unit must take a Battle-shock test. When doing so, if that enemy unit is Below Half-strength, subtract 1 from that test. This Enhancement cannot cause a unit to take two Battle-shock tests in the same phase.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Canoptek Harvesters Enhancements" id="019a-dab5-e06b-5708" hidden="false" collective="false" import="true">
